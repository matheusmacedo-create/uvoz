# Porta HTTP
PORT=3000

# Banco de dados MySQL 8+ (ou MariaDB 10.6+). As tabelas são criadas automaticamente.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uvoz
DB_USERNAME=uvoz
DB_PASSWORD=troque-esta-senha
# Alternativa: DATABASE_URL=mysql://usuario:senha@host:3306/uvoz

# Código exigido para CRIAR CONTA (deixe vazio para liberar a qualquer um com o link)
ACCESS_CODE=troque-este-codigo

# Máximo de pessoas por sala de voz/vídeo (malha P2P: recomendado até 8)
MAX_PEERS_PER_ROOM=8

# TURN com credenciais temporárias (recomendado; ver deploy/coturn/install.sh)
# TURN_SECRET=mesmo-segredo-do-coturn
# TURN_URLS=turn:SEU_IP:3478?transport=udp,turn:SEU_IP:3478?transport=tcp
# TURN_TTL_SECONDS=43200

# Alternativa: servidores STUN/TURN fixos em JSON. TURN é necessário para redes corporativas/4G restritas.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.unicopag.com:3478?transport=udp","turn:turn.unicopag.com:3478?transport=tcp"],"username":"uvoz","credential":"SENHA"}]

# Arquivo da versão antiga (antes do banco). Se existir, é importado uma única vez.
# DATA_FILE=./data/db.json

# Validade das sessões de login, em dias
# SESSION_TTL_DAYS=30
